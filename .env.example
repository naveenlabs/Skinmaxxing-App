# Copy to .env.local and fill in from your Supabase project
# (Project settings -> API). Both values are safe to expose in the client
# bundle -- row level security is what actually protects the data.
#
# The same two vars must also be set in Netlify:
# Site configuration -> Environment variables.
#
# Leave them unset and the app runs exactly as it did before auth existed:
# no sign-in screen, everything local. That's what keeps `npm run dev` and
# the Playwright audits in scripts/audit/ working without a Supabase project.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
