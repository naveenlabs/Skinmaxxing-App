{
  "name": "skinmaxxing-preview",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "verify": "npm run verify:p1 && npm run verify:p2",
    "verify:p1": "node scripts/audit/verify-p1.mjs /tmp/glass-verify /tmp/glass-fixtures",
    "verify:p2": "node scripts/audit/verify-p2.mjs /tmp/glass-p2",
    "fixtures": "node scripts/audit/mkfixtures.mjs /tmp/glass-fixtures",
    "shots": "node scripts/audit/snap.mjs /tmp/glass-shots",
    "shots:states": "node scripts/audit/snap-states.mjs /tmp/glass-shots"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "framer-motion": "^12.43.0",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.62.0",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^1.3.0"
  }
}
